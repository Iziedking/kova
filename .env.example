# KOVA environment. Names only; never commit values.
# Production values live on the API server (~/kova-secrets) and in Vercel project settings.

# --- Frontend (Vercel) ------------------------------------------------------
# Server-only origin of the API. next.config.ts rewrites /api/game/* to it.
KOVA_BACKEND_API_URL=
# `api` in production. `fixtures` is development-only sample data.
NEXT_PUBLIC_KOVA_DATA_SOURCE=
# Cluster the player's wallet signs for: solana:devnet (default) or solana:mainnet.
NEXT_PUBLIC_KOVA_SOLANA_CHAIN=
# Privy. The app id is public by design; the secret is server-only and the
# client-bundle scan fails the build if it reaches the browser.
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_SECRET=
# Development and test only, both require fixtures.
NEXT_PUBLIC_KOVA_PREVIEW_VIEWER=
NEXT_PUBLIC_KOVA_AUTH_STUB=

# --- API server -------------------------------------------------------------
KOVA_BACKEND_HOST=0.0.0.0
KOVA_BACKEND_PORT=8787
# Comma-separated exact origins, e.g. https://kova.surf,https://www.kova.surf
KOVA_ALLOWED_ORIGINS=http://localhost:3000
KOVA_DATABASE_URL=
KOVA_RECONCILIATION_INTERVAL_SECONDS=300
# HTTPS mainnet RPC for the Dealer's exact-mint evidence.
KOVA_SOLANA_RPC_URL=

# Game mode. When true, every value below in this block is required at boot.
KOVA_GAME_ENABLED=false
PRIVY_APP_ID=
# The stake token mint (TEST ANSEM on devnet).
KOVA_ANSEM_MINT=
# AES-256-GCM key for private picks: 32 random bytes, base64. Older keys as id:base64,id:base64.
KOVA_PICK_KEY_ID=
KOVA_PICK_ENCRYPTION_KEY=
KOVA_PICK_PREVIOUS_ENCRYPTION_KEYS=

# On-chain escrow. Leave the network empty to run the game without deposits.
# solana-devnet or solana-mainnet
KOVA_CHAIN_NETWORK=
KOVA_CHAIN_RPC_URL=
# Paths to 0600 keypair files. None of these keys ever holds player stakes,
# and the program upgrade key must not be one of them.
KOVA_OPERATOR_KEYPAIR_PATH=
KOVA_ORACLE_KEYPAIR_PATH=
KOVA_ADMISSION_KEYPAIR_PATH=
# Round length in seconds, 60 to 900.
KOVA_ROUND_SECONDS=900

# Dealer (ClawPump partner API). Set both or neither.
CLAWPUMP_API_KEY=
KOVA_DEALER_AGENT_ID=
# Per-request model override; openai/gpt-5.4-mini stays inside ClawPump's turn limit.
KOVA_DEALER_MODEL=
# 0 = the Dealer judges only KOVA-supplied evidence and calls no agent tools.
KOVA_DEALER_TOOL_BUDGET=0

# --- Scripts ----------------------------------------------------------------
# Used by npm run verify:preview.
KOVA_PUBLIC_URL=
# Legacy FLOAT Privy adapter; stays false.
KOVA_PRIVY_EXECUTION_ENABLED=false
