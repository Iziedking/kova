# All financial capabilities are unavailable in the architecture scaffold.
# Values here are documentation, not an authorization to enable a subsystem.
KOVA_MODE=preview
# VM backend preview. Keep the RPC URL empty until an approved read provider is configured.
KOVA_BACKEND_HOST=0.0.0.0
KOVA_BACKEND_PORT=8787
KOVA_ALLOWED_ORIGINS=http://localhost:3000
KOVA_SOLANA_RPC_URL=
KOVA_DATABASE_URL=
KOVA_RECONCILIATION_INTERVAL_SECONDS=300
# Optional server-only URL for the separately hosted VM backend. Leave empty for local captured previews.
KOVA_BACKEND_API_URL=
KOVA_LIVE_READS_ENABLED=false
KOVA_TRANSACTION_PREPARATION_ENABLED=false
KOVA_PAID_RESEARCH_ENABLED=false
KOVA_RESEARCH_DAILY_USDC_MICRO=0
KOVA_RESEARCH_PER_DECISION_USDC_MICRO=0
KOVA_MODEL_DAILY_USD_MICRO=0
# Legacy delegated-wallet seam only. Wallet Standard is the user-owned browser path.
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_ID=
PRIVY_APP_SECRET=
KOVA_PRIVY_EXECUTION_ENABLED=false
# No LP private key or research private key belongs in this file.
