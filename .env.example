# All financial capabilities are unavailable in the architecture scaffold.
# Values here are documentation, not an authorization to enable a subsystem.
KOVA_MODE=preview
# Public Vercel origin used only by the read-only post-deploy verifier.
# Production: https://kova.surf
KOVA_PUBLIC_URL=
# VM backend preview. Keep the RPC URL empty until an approved read provider is configured.
KOVA_BACKEND_HOST=0.0.0.0
KOVA_BACKEND_PORT=8787
# Production: https://kova.surf
KOVA_ALLOWED_ORIGINS=http://localhost:3000
KOVA_SOLANA_RPC_URL=
KOVA_DATABASE_URL=
KOVA_RECONCILIATION_INTERVAL_SECONDS=300
KOVA_GAME_ENABLED=false
# Durable game admission requires all fields below. The backend fails at boot if
# game mode is enabled without Postgres, Privy verification or encryption.
KOVA_ANSEM_MINT=
KOVA_PICK_KEY_ID=
KOVA_PICK_ENCRYPTION_KEY=
KOVA_PICK_PREVIOUS_ENCRYPTION_KEYS=
# Optional server-only URL for the separately hosted VM backend. Leave empty
# for local captured previews. Production: https://api.kova.surf
KOVA_BACKEND_API_URL=
KOVA_LIVE_READS_ENABLED=false
KOVA_TRANSACTION_PREPARATION_ENABLED=false
KOVA_PAID_RESEARCH_ENABLED=false
KOVA_RESEARCH_DAILY_USDC_MICRO=0
KOVA_RESEARCH_PER_DECISION_USDC_MICRO=0
KOVA_MODEL_DAILY_USD_MICRO=0
# Privy authentication. NEXT_PUBLIC_PRIVY_APP_ID is public by design and ships in
# the browser bundle; PRIVY_APP_SECRET is server-only and is scanned for by
# npm run check:client-bundle. Delegated signing stays disabled: embedded wallet
# creation is 'off' and no component may request a signature.
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_ID=
PRIVY_APP_SECRET=
KOVA_PRIVY_EXECUTION_ENABLED=false
# No LP private key or research private key belongs in this file.
