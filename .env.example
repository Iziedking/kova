# All financial capabilities are unavailable in the architecture scaffold.
# Values here are documentation, not an authorization to enable a subsystem.
FLOAT_MODE=preview
# VM backend preview. Keep the RPC URL empty until an approved read provider is configured.
FLOAT_BACKEND_HOST=0.0.0.0
FLOAT_BACKEND_PORT=8787
FLOAT_ALLOWED_ORIGINS=http://localhost:3000
FLOAT_SOLANA_RPC_URL=
FLOAT_DATABASE_URL=
FLOAT_RECONCILIATION_INTERVAL_SECONDS=300
# Optional server-only URL for the separately hosted VM backend. Leave empty for local captured previews.
FLOAT_BACKEND_API_URL=
FLOAT_LIVE_READS_ENABLED=false
FLOAT_TRANSACTION_PREPARATION_ENABLED=false
FLOAT_PAID_RESEARCH_ENABLED=false
FLOAT_RESEARCH_DAILY_USDC_MICRO=0
FLOAT_RESEARCH_PER_DECISION_USDC_MICRO=0
FLOAT_MODEL_DAILY_USD_MICRO=0
# Legacy delegated-wallet seam only. Wallet Standard is the user-owned browser path.
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_ID=
PRIVY_APP_SECRET=
FLOAT_PRIVY_EXECUTION_ENABLED=false
# No LP private key or research private key belongs in this file.
